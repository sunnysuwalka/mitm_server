MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=MITM
COLLECTION_NAME=events
DEVICE_TOKEN=REPLACE_WITH_A_RANDOM_64+_CHARACTER_TOKEN
TTL_DAYS=30
PORT=10000
MAX_BATCH=50
# Safe by default. Set true only when you want URL/query values in Render logs.
LOG_EVENT_DETAILS=false
# Periodic server/Mongo telemetry heartbeat.
TELEMETRY_HEARTBEAT_MS=60000
